<?xml version='1.0' encoding='windows-1252'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Ai Usage Monitor'
        UpgradeCode='81DC8E3F-9FC4-439C-B467-D841F8DB9892'
        Manufacturer='youfuku-sg'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer'
            Description='Ai Usage Monitor Installer'
            Manufacturer='youfuku-sg'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='main.cab' EmbedCab='yes'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='LocalAppDataFolder'>
                <Directory Id='APPLICATIONFOLDER' Name='AiUsageMonitor'>
                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='ai-usage-monitor.exe'
                            DiskId='1'
                            Source='target\release\claude-code-usage-monitor.exe'/>
                        <RemoveFolder
                            Id='RemoveApplicationFolder'
                            Directory='APPLICATIONFOLDER'
                            On='uninstall'/>
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\youfuku-sg\AiUsageMonitor'
                            Name='path'
                            Type='string'
                            Value='[APPLICATIONFOLDER]'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Ai Usage Monitor'>
                    <Component Id='ApplicationShortcut' Guid='*'>
                        <Shortcut
                            Id='ApplicationStartMenuShortcut'
                            Name='Ai Usage Monitor'
                            Description='Claude Code / Codex 使用量モニター'
                            Target='[APPLICATIONFOLDER]ai-usage-monitor.exe'
                            WorkingDirectory='APPLICATIONFOLDER'/>
                        <RemoveFolder
                            Id='CleanUpShortCut'
                            Directory='ApplicationProgramsFolder'
                            On='uninstall'/>
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\youfuku-sg\AiUsageMonitor'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature Id='Application' Title='Ai Usage Monitor' Level='1'>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ApplicationShortcut'/>
        </Feature>
    </Product>
</Wix>
